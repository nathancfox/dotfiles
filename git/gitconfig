[user]
    name = Nathan Fox
    email = nchristopherfox@gmail.com
[init]
    defaultBranch = main
[core]
    editor = vim
    pager = delta
[push]
    autoSetupRemote = true
[pull]
    rebase = true
[diff]
    algorithm = histogram
[merge]
    conflictStyle = zdiff3
[color]
    ui = auto
[credential]
    helper = store
[interactive]
    diffFilter = delta --color-only
[delta]
    hyperlinks = true
    navigate = true
    side-by-side = true
